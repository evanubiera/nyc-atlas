# Rendered by the nginx entrypoint's envsubst on container start.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Hashed filenames, so these can be cached hard.
  location ~* \.(js|css|woff2?|png|svg|jpg|webp)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }

  # index.html carries the runtime config, so it must never be cached:
  # a stale copy would point the browser at the previous cluster's endpoint.
  location = /index.html {
    add_header Cache-Control "no-store, must-revalidate";
  }

  # A single-page app: unknown paths are routes, not missing files.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Serves the API from the same origin when an upstream is configured, which
  # avoids CORS entirely. Left unset, the page calls whatever absolute
  # endpoint the runtime config names instead.
  location /graphql {
    proxy_pass ${BFF_ORIGIN};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
