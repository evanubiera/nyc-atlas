{
  "name": "nyc-census-app",
  "version": "0.1.0",
  "private": true,
  "description": "NYC Income and Cultural Institution gaps",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/bff",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build -w @nyc-atlas/shared && npm run build -w @nyc-atlas/bff && npm run build -w @nyc-atlas/web",
    "build:shared": "npm run build -w @nyc-atlas/shared",
    "dev": "npm run build:shared && concurrently -n bff,web -c blue,green \"npm:dev:bff\" \"npm:dev:web\"",
    "dev:bff": "npm run dev -w @nyc-atlas/bff",
    "dev:web": "npm run dev -w @nyc-atlas/web",
    "typecheck": "tsc -b packages/shared packages/bff packages/web",
    "verify:sources": "node scripts/verify-sources.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "generate:types": "node scripts/generate-graphql-types.mjs",
    "check:types-fresh": "node scripts/generate-graphql-types.mjs --check",
    "ingest": "npm run ingest -w @nyc-atlas/bff",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "rebuild": "npm run clean && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~6.0.3"
  }
}
