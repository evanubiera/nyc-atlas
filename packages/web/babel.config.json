{
  "presets": [
    ["@babel/preset-env", { "targets": { "esmodules": true }, "bugfixes": true }],
    ["@babel/preset-react", { "runtime": "automatic" }],
    "@babel/preset-typescript"
  ],
  "plugins": [
    ["babel-plugin-styled-components", { "displayName": true, "fileName": false, "pure": true }]
  ]
}
