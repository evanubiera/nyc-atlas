# ---------------------------------------------------------------------------
# All keys below are OPTIONAL. The app runs without them (see specs/001 NFR-4/5).
# ---------------------------------------------------------------------------

# Census API key — REQUIRED for live ACS demographics.
# The Census API now rejects unkeyed requests (302 -> missing_key.html), verified
# 2026-10-24. Free, instant: https://api.census.gov/data/key_signup.html
# Without it, demographic features degrade gracefully using data/cache/.
CENSUS_API_KEY=

# Socrata app token — optional. Raises NYC Open Data rate limits.
# Free: https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# BFF
PORT=4000
NODE_ENV=development

# Where the ingest caches live. Defaults to the repo's data/cache; set this in
# a container, where the working directory is whatever the image declares.
CACHE_DIR=

# Comma-separated origins allowed to call the API. Empty reflects the caller's
# origin, which is fine locally. In production the app refuses to start without
# it rather than serving every origin.
CORS_ORIGINS=

# Stamped in by CI so a running deploy can be identified from /healthz.
GIT_SHA=

# Web -> BFF
GRAPHQL_ENDPOINT=http://localhost:4000/graphql
